<mxfile host="drawio" version="31.3.1">
  <diagram name="理论力学·学习路线图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="1960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="goal" value="🎯 总目标:力学体系地基&#xa;受力图 · 力系平衡 · 运动描述 · 三大定理 · 接入流体力学" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="40" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pace" value="⏱ 建议配速(自定节奏,无考试锚点)&#xa;每周 2~3 课,与流体力学课交替进行&#xa;每课:手册 → 课内测验 → Obsidian 习题集&#xa;笔记 status: todo → learning → done" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="link" value="🔗 与流体力学并行联动&#xa;受力分析 ↔ 流体微元受力&#xa;动量定理 ↔ 积分形式动量方程&#xa;惯性力 ↔ 旋转参考系(泵/风机 CFD)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="P1 静力学(第 1~4 课)&#xa;第1课 静力学公理与受力分析&#xa;第2课 平面汇交力系与力偶&#xa;第3课 平面任意力系 · 第4课 摩擦" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="440" height="130" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="验收 M1&#xa;受力图 10 分钟全对?&#xa;平衡方程 5 题全对?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="350" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="P2 运动学(第 5~8 课)&#xa;第5课 点的运动学 · 第6课 刚体基本运动&#xa;第7课 点的合成运动(科氏加速度)&#xa;第8课 刚体平面运动(瞬心法)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="440" height="130" as="geometry" />
        </mxCell>

        <mxCell id="m2" value="验收 M2&#xa;速度合成法与瞬心法互验一致?&#xa;科氏加速度方向 5 题全对?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="690" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p3" value="P3 动力学(第 9~12 课)&#xa;第9课 质点动力学与动量定理&#xa;第10课 动量矩定理 · 第11课 动能定理&#xa;第12课 达朗贝尔原理与虚位移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="850" width="440" height="130" as="geometry" />
        </mxCell>

        <mxCell id="m3" value="验收 M3&#xa;三大定理综合题独立完成?&#xa;说得清每定理的适用场景?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1030" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p4" value="P4 收官与衔接&#xa;同一题:牛顿法 ↔ 动静法/虚功互验&#xa;写「理论力学如何接入流体力学」小结" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1190" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m4" value="验收 M4&#xa;两法互验一致?&#xa;衔接小结完成?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1340" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p5" value="P5 专题篇(第 13~18 课)&#xa;非惯性系动力学 · 碰撞(撞击中心)&#xa;刚体平面运动动力学 · 变质量动力学&#xa;分析力学:拉格朗日方程与哈密顿视角" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
